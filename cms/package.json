{
  "name": "sherlockramosblog-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migration": "payload migrate:create",
    "admin:create": "tsx scripts/admin.ts",
    "content:import": "tsx scripts/import-hugo.ts",
    "content:export": "tsx scripts/export.ts",
    "content:restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-vercel-blob": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
